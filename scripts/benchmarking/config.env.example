# Benchmarking configuration — machine-local, never committed.
#
# Usage:
#   cd scripts/benchmarking
#   cp config.env.example config.env
#   # edit config.env, then:
#   python main.py --model model.gguf --accuracy datasets --performance_benchmark
#
# config.py loads ./config.env automatically, so run benchmarks from this
# directory. Every variable below is also accepted from the environment.

# ── Required: paths ───────────────────────────────────────────────────────────

# Path to the compiled llama-server binary. llama-bench and llama-perplexity are
# looked up alongside it unless LLAMA_BENCH is set.
LLAMA_SERVER=

# Path to the neurips-edge-llm-challenge-sampled dataset directory.
DATASET_ROOT=

# ── Optional: hardware ────────────────────────────────────────────────────────

# GPU layers to offload.
#   99 = all layers (default; accepted by every llama.cpp binary)
#    0 = CPU only
#    N = exact layer count
LLAMA_N_GPU_LAYERS=99

# CPU threads for token generation / for prompt (batch) evaluation.
# 0 = let llama.cpp decide.
LLAMA_N_THREADS=0
LLAMA_N_THREADS_BATCH=0

# Logical batch size for prompt processing.
LLAMA_BATCH_SIZE=512

# Context window in tokens. Also the ctx_len used for KV-cache and FLOPs maths.
LLAMA_N_CTX=4096

# KV cache element dtype: f16 or q5_0.
LLAMA_KV_CACHE_TYPE=f16

# ── Optional: inference ───────────────────────────────────────────────────────

# 0 = greedy / deterministic.
LLAMA_TEMPERATURE=0

# Max tokens per response (HumanEval is exempted and runs uncapped).
LLAMA_N_PREDICT=512

# ── Perplexity (only for --accuracy perplexity) ───────────────────────────────

# Path to wiki.test.raw (WikiText-2 test split).
WIKITEXT_PATH=

# ── Performance benchmarking (only for --performance_benchmark) ───────────────

# Peak memory bandwidth of this device in GB/s, used for MBU.
#   M3 Pro ≈ 150, Jetson Orin Nano ≈ 68
PEAK_MEMORY_BW_GBPS=150

# Path to llama-bench. Defaults to a sibling of LLAMA_SERVER.
# LLAMA_BENCH=
