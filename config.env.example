# Benchmarking configuration — machine-local, never committed.
#
# Usage:
#   cp config.env.example config.env
#   # Edit config.env, then before every benchmark session:
#   source config.env && python scripts/benchmarking/run_eval.py --model model.gguf --datasets gsm8k
#
# bootstrap.sh will generate this file with hardware auto-detection if it does not exist.

# ── Required: paths ───────────────────────────────────────────────────────────

# Absolute path to the compiled llama-server binary.
# Run bootstrap.sh to build it from llama-cpp-thesis.
export LLAMA_SERVER=

# Absolute path to the neurips-edge-llm-challenge-sampled dataset directory.
export DATASET_ROOT=

# ── Optional: hardware tuning ─────────────────────────────────────────────────

# GPU backend used when building llama-server (read by bootstrap.sh).
#   auto   = detect at build time: CUDA → Metal → CPU  (default)
#   cuda   = NVIDIA CUDA
#   rocm   = AMD ROCm/HIP
#   metal  = Apple Metal
#   vulkan = Vulkan (cross-platform fallback)
#   cpu    = CPU only
export LLAMA_BACKEND=auto

# GPU layers to offload into VRAM.
#   0   = CPU only (default)
#  -1   = all layers (full GPU)
#   N   = first N transformer layers on GPU, rest on CPU
export LLAMA_N_GPU_LAYERS=0

# CPU threads used for token generation.
# 0 = let llama.cpp decide (uses all physical cores).
export LLAMA_N_THREADS=0

# CPU threads used for prompt evaluation (batch processing).
# 0 = let llama.cpp decide.
export LLAMA_N_THREADS_BATCH=0

# Logical batch size for prompt processing.
export LLAMA_BATCH_SIZE=512
